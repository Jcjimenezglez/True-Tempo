{
  "name": "focus-timer-pomodoro",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build:assets": "node scripts/build-assets.js",
    "build:pseo": "node scripts/build-pseo.js",
    "build:marketing": "npm --prefix marketing ci && npm --prefix marketing run build && node scripts/publish-marketing.js",
    "build": "npm run apply-pain-copy && npm run apply-seo-plan && npm run build:assets && npm run build:pseo && npm run build:marketing",
    "apply-pain-copy": "node scripts/apply-pain-copy.js",
    "apply-seo-plan": "node scripts/apply-seo-plan.js",
    "dev": "vercel dev",
    "setup-dev": "node scripts/setup-dev.js",
    "deploy-staging": "node scripts/deploy-staging.js",
    "logs": "vercel logs --follow",
    "update-logo": "node scripts/update-logo-from-png.js",
    "indexnow": "node scripts/submit-indexnow.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@clerk/clerk-js": "^5.113.0",
    "@clerk/clerk-sdk-node": "^5.0.24",
    "@vercel/kv": "^3.0.0",
    "redis": "^5.10.0",
    "resend": "^4.8.0",
    "stripe": "^20.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jest": "^29.7.0",
    "jest-mock-extended": "^3.0.5",
    "sharp": "^0.34.5"
  }
}
